---
import BaseLayout from "../layouts/BaseLayout.astro";
import StageHero from "../components/StageHero.astro";
import PhotoMosaic from "../components/PhotoMosaic.astro";
import ContentImage from "../components/ContentImage.astro";
import SightCard from "../components/SightCard.astro";
import HotelCard from "../components/HotelCard.astro";
import DistrictCard from "../components/DistrictCard.astro";
import NewsCard from "../components/NewsCard.astro";
import Stay22TopHotels from "../components/Stay22TopHotels.astro";
import GetYourGuideWidget from "../components/GetYourGuideWidget.astro";
import { city } from "../data/city";
import { getGygPlacement } from "../data/gyg";
import { sights, sightsByDistrict } from "../data/sights";
import { topHotels } from "../data/hotels";
import { districts } from "../data/districts";
import { recentNews } from "../data/news";
import { features } from "../data/features";

const featuredSights = sights.slice(0, 6);
const featuredHotels = topHotels(4);
const featuredDistricts = districts.slice(0, 6);
const featuredNews = features.news.enabled ? recentNews(3) : [];
const durlachSights = sightsByDistrict("durlach").length;

/* Fuenf Einstiege, gemischte Kachelgroessen (Mockup Variante 3) */
const mosaikItems = [
  { href: "/bezirke/durlach/", imgKey: "district:durlach", title: "Durlach", meta: `Älter als die Stadt · ${durlachSights} Orte`, span: "h2" as const },
  { href: "/kategorien/museen/", imgKey: "sight:staatliche-kunsthalle", title: "Kunst & Museen", meta: "Kunsthalle, ZKM, Landesmuseum", span: "w2" as const },
  { href: "/kategorien/parks/", imgKey: "sight:schlossgarten", title: "Parks", meta: "Schlossgarten, Stadtgarten" },
  { href: "/sehenswuerdigkeiten/turmberg/", imgKey: "sight:turmberg", title: "Aussicht", meta: "Turmberg" },
  { href: "/sehenswuerdigkeiten/marktplatz-pyramide/", imgKey: "sight:marktplatz-pyramide", title: "Der Fächer", meta: "Marktplatz, Pyramide, Kaiserstraße", span: "w2" as const },
];
---

<BaseLayout title={city.name} description={city.description.long} alternateUrls={{ de: "/", en: "/en/" }}>
  <!-- BUEHNEN-HERO -->
  <StageHero
    imgKey="sight:karlsruher-schloss"
    badge="Fächerstadt"
    title="Karlsruhe beginnt am Schloss."
    lead={`${city.stats.sights} Sehenswürdigkeiten, ${city.stats.districts} Bezirke, ${city.stats.restaurants} Restaurants - mit echten Fotos, geprüften Angaben und ohne Ranking-Karussell.`}
  />

  <!-- SUCHE -->
  <section class="border-b" style="border-color: var(--color-border); background: var(--color-surface);">
    <div class="container-page py-5">
      <form role="search" action="/suche/" method="get" class="flex items-center gap-2 max-w-xl">
        <label for="hero-search" class="sr-only">Suche auf Karlsruhe-Interaktiv</label>
        <input
          id="hero-search"
          type="search"
          name="q"
          autocomplete="off"
          placeholder="Schloss, ZKM, KIT, Brauhaus, Innenstadt, …"
          class="flex-1 border px-5 py-3 text-base focus:outline-none transition-colors text-left"
          style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text); border-radius: var(--radius-input, 6px);"
          onfocus="this.style.borderColor='var(--color-accent)'"
          onblur="this.style.borderColor='var(--color-border)'"
        />
        <button type="submit" class="btn-primary shrink-0">Suchen</button>
      </form>
    </div>
  </section>

  <!-- WO ANFANGEN: Mosaik -->
  <section class="stage-sec">
    <div class="container-page">
      <h2>Wo anfangen</h2>
      <p class="stage-sub">Fünf Einstiege, die den größten Teil der Stadt abdecken.</p>
      <PhotoMosaic items={mosaikItems} />
    </div>
  </section>

  <!-- TOP SIGHTS -->
  <section class="stage-sec alt">
    <div class="container-page">
      <div class="flex items-end justify-between mb-2">
        <h2>Sehenswürdigkeiten in Karlsruhe</h2>
        <a href="/sehenswuerdigkeiten/" class="hidden sm:inline-flex link-accent text-sm">Alle ansehen &rarr;</a>
      </div>
      <p class="stage-sub">Vom barocken Schloss bis zum ZKM - die wichtigsten Orte der Fächerstadt.</p>
      <div class="mosaic">
        {featuredSights.map((s, i) => (
          <div class={i === 0 ? "w2" : undefined}><SightCard sight={s} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- GETYOURGUIDE TOUREN & TICKETS -->
  <section class="container-page">
    <GetYourGuideWidget placement={getGygPlacement("page:home")} />
  </section>

  <!-- STORY: Schwerpunkt -->
  <div class="story">
    <div class="story-pic">
      <ContentImage imgKey="sight:bundesverfassungsgericht" fallbackHue={1} imgClass="w-full h-full object-cover" />
    </div>
    <div class="story-txt">
      <span class="badge">Schwerpunkt</span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mt-4 mb-3" style="color: var(--color-text);">Residenz des Rechts</h2>
      <p class="stage-sub" style="margin-bottom: 20px;">
        Warum das höchste deutsche Gericht in Karlsruhe sitzt - und was davon zu sehen ist.
      </p>
      <a href="/sehenswuerdigkeiten/bundesverfassungsgericht/" class="btn-outline">Weiterlesen &rarr;</a>
    </div>
  </div>

  <!-- BEZIRKE -->
  <section class="stage-sec">
    <div class="container-page">
      <div class="flex items-end justify-between mb-2">
        <h2>Karlsruher Bezirke</h2>
        <a href="/bezirke/" class="hidden sm:inline-flex link-accent text-sm">Alle Bezirke &rarr;</a>
      </div>
      <p class="stage-sub">Den Fächer entlang - von der Innenstadt bis Neureut.</p>
      <div class="mosaic">
        {featuredDistricts.map((d, i) => (
          <div class={i === 1 ? "w2" : undefined}><DistrictCard district={d} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- TOP HOTELS (Live Stay22 + redaktionell) -->
  <section class="stage-sec alt">
    <div class="container-page">
      <div class="flex items-end justify-between mb-2">
        <h2>Top-Hotels in Karlsruhe</h2>
        <a href="/hotels/" class="hidden sm:inline-flex link-accent text-sm">Alle Hotels &rarr;</a>
      </div>
      <Stay22TopHotels limit={4} title="" lead="Live von Booking.com - aktuelle Preise und Verfügbarkeit, täglich aktualisiert." />
      <div class="mosaic mt-4">
        {featuredHotels.map((h) => (
          <div><HotelCard hotel={h} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- NEWS / Tech-USP -->
  {features.news.enabled && featuredNews.length > 0 && (
    <section class="stage-sec">
      <div class="container-page">
        <div class="flex items-end justify-between mb-2">
          <h2>Karlsruhe-News</h2>
          <a href="/news/" class="hidden sm:inline-flex link-accent text-sm">Alle News &rarr;</a>
        </div>
        <p class="stage-sub">Tech, Wissenschaft und Kultur aus der Stadt.</p>
        <div class="mosaic cols-3">
          {featuredNews.map((n) => (
            <div><NewsCard item={n} /></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Apotheken & Gesundheit -->
  <section class="stage-sec">
    <div class="container-page">
      <div class="apo-home">
        <p class="apo-home-eyebrow">Gesundheit</p>
        <h2 class="apo-home-h2">Apotheken in Karlsruhe: Adressen und Versandalternative</h2>
        <p>Von der Innenstadt über Mühlburg und die Oststadt bis Durlach ist die Versorgung solide, doch nach Feierabend gilt der wechselnde Notdienst für den gesamten Stadtkreis. Wer nicht suchen will, schaut vorher nach. Adressen nach Stadtteil und die Notdiensthinweise haben wir bei den <a href="/apotheken-karlsruhe/">Apotheken in Karlsruhe</a> zusammengestellt.</p>
        <p>Für den planbaren Bedarf ist der Versandweg meist günstiger. Bei rezeptfreien Medikamenten und Pflegeprodukten summieren sich die Unterschiede über das Jahr deutlich. Welche Versandapotheke nach Karlsruhe wie schnell liefert und welche Versandkostengrenze gilt, steht im <a href="/online-apotheke-karlsruhe/">Online-Apotheken-Vergleich</a>.</p>
      </div>
    </div>
  </section>

  <!-- Feiern & Events -->
  <section class="stage-sec">
    <div class="container-page">
      <div class="apo-home">
        <p class="apo-home-eyebrow">Feiern &amp; Events</p>
        <h2 class="apo-home-h2">Fotobox für Hochzeit und Firmenfeier in Karlsruhe</h2>
        <p>Von der Fotosäule mit Touchscreen über den Magic-Mirror-Fotospiegel bis zum restaurierten Oldtimer-Bus: Wer in der Fächerstadt feiert, hat bei Fotoboxen inzwischen echte Auswahl - und die Angebote unterscheiden sich weniger im Stundenpreis als bei Anfahrt, Betreuung und Druckkontingent. Welche Variante zu welchem Anlass passt und worauf es bei der Buchung ankommt, steht im Ratgeber <a href="/fotobox-mieten-karlsruhe/">Fotobox mieten in Karlsruhe</a>.</p>
      </div>
    </div>
  </section>

  <!-- FUER BETRIEBE -->
  <section class="stage-sec alt border-t" style="border-color: var(--color-border);">
    <div class="container-page">
      <h2>Für Betriebe aus Karlsruhe</h2>
      <p class="stage-sub">
        Grundeintrag kostenlos und dauerhaft. Premium-Auftritt 199 € pro Jahr netto, nur für Unternehmer.
      </p>
      <a href="/werben/" class="btn-primary">Werbemöglichkeiten &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Apotheken-Teaser (Startseite) */
  .apo-home { max-width: 70ch; }
  .apo-home-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; opacity: .6; margin: 0 0 8px;
  }
  .apo-home-h2 {
    font-size: clamp(24px, 3.2vw, 32px); font-weight: 600; line-height: 1.15;
    letter-spacing: -.02em; margin: 0 0 14px;
  }
  .apo-home p { font-size: 1rem; line-height: 1.75; margin: 0 0 12px; opacity: .88; }
  .apo-home p:last-child { margin-bottom: 0; }
  .apo-home a {
    color: inherit; font-weight: 600; text-decoration: underline;
    text-underline-offset: 3px; text-decoration-thickness: 1px;
  }
  .apo-home a:hover { text-decoration-thickness: 2px; }
</style>
