  .ha-surface h2 { color: #20233a; font-size: 1.55rem; font-weight: 800; line-height: 1.25; letter-spacing: -0.3px; margin: 2.2rem 0 0.8rem; }
  .ha-surface h3 { color: #20233a; font-size: 1.2rem; font-weight: 700; line-height: 1.3; margin: 1.5rem 0 0.5rem; }
  .ha-surface p { margin: 0 0 1.05rem; }
  .ha-surface ul, .ha-surface ol { margin: 0 0 1.15rem; padding-left: 1.4rem; }
  .ha-surface li { margin-bottom: 0.5rem; }
  .ha-surface strong { color: #20233a; font-weight: 700; }
  .ha-surface a { color: #365DA3; text-decoration: underline; text-underline-offset: 3px; }
  .ha-surface .faq-item { border-top: 1px solid #e6e6ef; padding-top: 1.1rem; margin-top: 1.1rem; }
