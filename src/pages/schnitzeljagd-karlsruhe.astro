<script>
  (function () {
    document.querySelectorAll("[data-vs-stations]").forEach(function (box) {
      var chips = box.querySelectorAll(".vs-chip");
      var cards = box.querySelectorAll(".vs-card");
      var empty = box.querySelector(".vs-empty");
      chips.forEach(function (chip) {
        chip.addEventListener("click", function () {
          var tag = chip.getAttribute("data-tag");
          chips.forEach(function (c) {
            var on = c === chip;
            c.classList.toggle("is-active", on);
            c.setAttribute("aria-pressed", on ? "true" : "false");
          });
          var shown = 0;
          cards.forEach(function (card) {
            var hit = tag === "alle" || tag === "all" ||
              (" " + card.getAttribute("data-tags") + " ").indexOf(" " + tag + " ") > -1;
            card.hidden = !hit;
            if (hit) shown++;
          });
          if (empty) empty.hidden = shown > 0;
        });
      });
    });
  })();
</script>

