---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RestaurantCard from "../../components/RestaurantCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { publishedRestaurants as restaurants } from "../../data/restaurants";
import { city } from "../../data/city";
import { indexUrl } from "../../i18n/config";

const sorted = [...restaurants].sort((a, b) => a.name.localeCompare(b.name, "de"));
const cuisines = [...new Set(restaurants.map((r) => r.cuisine))].sort();
---

<BaseLayout title={`Restaurants in ${city.name}`} description="Restaurants in Karlsruhe: Badisch, Stern-Küche, Italienisch, Asiatisch - geprüft, sortiert nach Bezirk und Küche." alternateUrls={{ de: indexUrl("restaurants", "de"), en: indexUrl("restaurants", "en") }}>
  <div class="container-page py-12">
    <Breadcrumbs items={[{label: "Start", href: "/"}, {label: "Restaurants"}]} />
    <header class="mb-12">
      <p class="eyebrow mb-3">{restaurants.length} Adressen</p>
      <h1 class="text-4xl sm:text-6xl font-medium tracking-tight mb-4" style="color: var(--color-text);">Restaurants in Karlsruhe</h1>
      <p class="text-lg max-w-3xl mb-6" style="color: var(--color-text-body);">
        Von der legendären Oberlaender Weinstube bis zum Stern-Restaurant Sein, von badischen Brauhäusern bis zur Südstadt-Pho-Adresse - Karlsruhes Gastronomie in einer Übersicht.
      </p>
      <div class="flex flex-wrap gap-2">
        {cuisines.map((c) => <span class="pill">{c}</span>)}
      </div>
    </header>
    <div class="mosaic">
      {sorted.map((r, i) => (
        <div class={i % 7 === 0 ? "w2" : i % 7 === 3 ? "h2" : undefined}><RestaurantCard restaurant={r} /></div>
      ))}
    </div>
  </div>
</BaseLayout>
