---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DistrictCard from "../../components/DistrictCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import GetYourGuideWidget from "../../components/GetYourGuideWidget.astro";
import { districts } from "../../data/districts";
import { getGygPlacement } from "../../data/gyg";
---

<BaseLayout title="Bezirke" description="Alle 14 Karlsruher Bezirke - von Innenstadt-West bis Neureut, mit Durlach und Oststadt prominent." alternateUrls={{ de: "/bezirke/", en: "/en/districts/" }}>
  <div class="container-page py-12">
    <Breadcrumbs items={[{label: "Start", href: "/"}, {label: "Bezirke"}]} />
    <header class="mb-12">
      <p class="eyebrow mb-3">{districts.length} Bezirke</p>
      <h1 class="text-4xl sm:text-6xl font-medium tracking-tight mb-4" style="color: var(--color-text);">Karlsruher Bezirke</h1>
      <p class="text-lg max-w-3xl" style="color: var(--color-text-body);">
        Vom Fächer-Ursprung am Schloss bis zum historischen Durlach am Turmberg, vom KIT-Umfeld in der Oststadt bis zum dörflichen Neureut - alle Karlsruher Bezirke im Überblick.
      </p>
    </header>
    <div class="mosaic">
      {districts.map((d, i) => (
        <div class={i % 6 === 0 ? "w2" : i % 6 === 4 ? "h2" : undefined}><DistrictCard district={d} /></div>
      ))}
    </div>

    <GetYourGuideWidget placement={getGygPlacement("page:districts-index")} />
  </div>
</BaseLayout>
