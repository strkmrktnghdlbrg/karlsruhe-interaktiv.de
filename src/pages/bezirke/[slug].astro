---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import StageHero from "../../components/StageHero.astro";
import ActionDock from "../../components/ActionDock.astro";
import SightCard from "../../components/SightCard.astro";
import HotelCard from "../../components/HotelCard.astro";
import RestaurantCard from "../../components/RestaurantCard.astro";
import Stay22NearbyHotels from "../../components/Stay22NearbyHotels.astro";
import GetYourGuideWidget from "../../components/GetYourGuideWidget.astro";
import { districts, getDistrict } from "../../data/districts";
import { sightsByDistrict } from "../../data/sights";
import { topHotelsByDistrict } from "../../data/hotels";
import { restaurantsByDistrict } from "../../data/restaurants";
import { getGygPlacement } from "../../data/gyg";
import { districtsEn } from "../../i18n/en/districts";
import { detailUrl } from "../../i18n/config";

export function getStaticPaths() {
  return districts.map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const district = getDistrict(slug!);
if (!district) return Astro.redirect("/404");

const sightItems = sightsByDistrict(district.slug);
const hotelItems = topHotelsByDistrict(district.slug, 8);
const restItems = restaurantsByDistrict(district.slug).slice(0, 8);

const alternateUrls = {
  de: `/bezirke/${district.slug}/`,
  en: detailUrl("districts", districtsEn[district.slug].slug, "en"),
};
---

<BaseLayout title={district.name} description={district.shortDesc} alternateUrls={alternateUrls}>
  <StageHero
    imgKey={district.imageKey ?? `district:${district.slug}`}
    badge={`Bezirk · ${district.characterTags.slice(0, 2).join(" · ")}`}
    title={district.name}
    lead={district.shortDesc}
    fallbackHue={district.hue}
    minHeight="500px"
  />

  <ActionDock
    info={{
      line: district.name,
      sub: `${sightItems.length} Sehenswürdigkeiten · ${hotelItems.length} Hotels · ${restItems.length} Restaurants`,
    }}
    secondary={{ label: "Alle Bezirke", href: "/bezirke/" }}
    primary={{ label: "Hotels im Bezirk", href: "#hotels-im-bezirk" }}
  />

  <div class="container-page py-10">
    <Breadcrumbs items={[{label: "Start", href: "/"}, {label: "Bezirke", href: "/bezirke/"}, {label: district.name}]} />

    <div class="stage-prose mt-6 mb-4">
      <p>{district.longDesc}</p>
    </div>
    <div class="flex flex-wrap gap-2 mb-6">
      {district.characterTags.map((t) => <span class="pill">{t}</span>)}
    </div>

    {sightItems.length > 0 && (
      <section class="section">
        <h2 class="text-3xl font-bold tracking-tight mb-6" style="color: var(--color-text);">Sehenswürdigkeiten in {district.name}</h2>
        <div class="mosaic">
          {sightItems.map((s, i) => (
            <div class={i === 0 ? "w2" : undefined}><SightCard sight={s} /></div>
          ))}
        </div>
      </section>
    )}

    {hotelItems.length > 0 && (
      <section id="hotels-im-bezirk" class="section border-t" style="border-color: var(--color-border);">
        <h2 class="text-3xl font-bold tracking-tight mb-6" style="color: var(--color-text);">Hotels in {district.name}</h2>
        <div class="mosaic">
          {hotelItems.map((h) => (
            <div><HotelCard hotel={h} /></div>
          ))}
        </div>
      </section>
    )}

    {restItems.length > 0 && (
      <section class="section border-t" style="border-color: var(--color-border);">
        <h2 class="text-3xl font-bold tracking-tight mb-6" style="color: var(--color-text);">Restaurants in {district.name}</h2>
        <div class="mosaic">
          {restItems.map((r) => (
            <div><RestaurantCard restaurant={r} /></div>
          ))}
        </div>
      </section>
    )}

    <GetYourGuideWidget placement={getGygPlacement(`district:${district.slug}`)} />

    <Stay22NearbyHotels
      lat={district.coordinates[0]}
      lng={district.coordinates[1]}
      near={district.name}
      radius={2500}
      limit={4}
    />
  </div>
</BaseLayout>
