---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import StageHero from "../../components/StageHero.astro";
import ActionDock from "../../components/ActionDock.astro";
import BookingCTA from "../../components/BookingCTA.astro";
import RelatedItems from "../../components/RelatedItems.astro";
import Stay22NearbyHotels from "../../components/Stay22NearbyHotels.astro";
import { hotels, getHotel } from "../../data/hotels";
import { getDistrict } from "../../data/districts";
import { heroKey, getImage } from "../../data/images";
import { city } from "../../data/city";
import { hotelsEn } from "../../i18n/en/hotels";
import { detailUrl } from "../../i18n/config";

export function getStaticPaths() {
  return hotels.map((h) => ({ params: { slug: h.slug } }));
}

const { slug } = Astro.params;
const hotel = getHotel(slug!);
if (!hotel) return Astro.redirect("/404");
const district = getDistrict(hotel.district);
const stars = "*".repeat(hotel.stars);

/* Kein eigenes Hotelfoto -> Bezirksfoto als ehrliche Buehne, Caption nennt den Bezirk */
const stageKey = heroKey(`hotel:${hotel.slug}`, hotel.district);
const usesDistrictPhoto = stageKey?.startsWith("district:") && Boolean(getImage(stageKey));

const schema = {
  "@context": "https://schema.org",
  "@type": "Hotel",
  name: hotel.name,
  description: hotel.shortDesc,
  starRating: { "@type": "Rating", ratingValue: hotel.stars },
  aggregateRating: { "@type": "AggregateRating", ratingValue: hotel.rating, reviewCount: hotel.reviews, bestRating: 10 },
  priceRange: `EUR ${hotel.priceFrom}+`,
  address: { "@type": "PostalAddress", addressLocality: city.name, addressCountry: city.countryCode },
};
---

<BaseLayout title={hotel.name} description={hotel.shortDesc} alternateUrls={{ de: detailUrl("hotels", hotel.slug, "de"), en: detailUrl("hotels", hotelsEn[hotel.slug].slug, "en") }}>
  <article>
    <StageHero
      imgKey={stageKey}
      badge={`${stars} · ${district?.name ?? hotel.district}`}
      title={hotel.name}
      lead={hotel.shortDesc}
      sceneLabel={usesDistrictPhoto && district ? `Foto: ${district.name}` : undefined}
      fallbackHue={hotel.imageHue}
      minHeight="500px"
    />

    <ActionDock
      info={{
        line: `ab ${hotel.priceFrom} EUR / Nacht`,
        sub: `${hotel.rating.toFixed(1)} von 10 · ${hotel.reviews} Gäste-Bewertungen${district ? ` · ${district.name}` : ""}`,
      }}
      secondary={district ? { label: "Zum Bezirk", href: `/bezirke/${district.slug}/` } : undefined}
      primary={{ label: "Auf Booking.com prüfen", href: hotel.bookingUrl, rel: "nofollow noopener sponsored", target: "_blank" }}
    />

    <div class="container-page py-10">
      <Breadcrumbs items={[
        { label: "Start", href: "/" },
        { label: "Hotels", href: "/hotels/" },
        { label: hotel.name },
      ]} />

      <div class="grid lg:grid-cols-[2fr_1fr] gap-10 mt-6 mb-12">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <span class="text-2xl font-bold" style="color: var(--color-text);">{hotel.rating.toFixed(1)}</span>
            <span class="text-sm" style="color: var(--color-text-muted);">{hotel.reviews} Gäste-Bewertungen</span>
            {hotel.guestFavorite && <span class="pill">Gästeliebling</span>}
          </div>
          <div class="stage-prose mb-6">
            <p>{hotel.longDesc}</p>
          </div>

          <div class="flex flex-wrap gap-2 mb-6">
            {hotel.amenities.map((a) => <span class="pill">{a}</span>)}
          </div>
        </div>

        <aside>
          <BookingCTA hotel={hotel} />
        </aside>
      </div>

      {district && (
        <div class="my-12 p-6 border" style="background: var(--color-surface); border-color: var(--color-border); border-radius: var(--radius-card);">
          <p class="eyebrow mb-2">Bezirk</p>
          <h2 class="text-xl font-semibold mb-2" style="color: var(--color-text);">{district.name}</h2>
          <p class="text-sm mb-3" style="color: var(--color-text-body);">{district.shortDesc}</p>
          <a href={`/bezirke/${district.slug}/`} class="link-accent text-sm">Bezirks-Hub ansehen &rarr;</a>
        </div>
      )}

      {district && (
        <Stay22NearbyHotels
          lat={district.coordinates[0]}
          lng={district.coordinates[1]}
          near={district.name}
          radius={2500}
          limit={4}
        />
      )}

      <RelatedItems district={hotel.district} excludeSlug={hotel.slug} type="hotels" />
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline></script>
  </article>
</BaseLayout>
