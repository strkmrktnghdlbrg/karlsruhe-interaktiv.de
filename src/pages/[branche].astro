---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { branchen, getBranche } from "../data/branchen";
import { city } from "../data/city";
import EntityBrief from "../components/EntityBrief.astro";

/**
 * /fitnessstudios-karlsruhe/ wird seit dem Vergleichs-Umbau von der statischen
 * Seite src/pages/fitnessstudios-karlsruhe.astro bedient. Der Slug muss hier
 * raus, sonst erzeugen beide Routen denselben Pfad.
 */
export function getStaticPaths() {
  // Inline, nicht als Modul-Konstante: Astro zieht getStaticPaths aus dem
  // Frontmatter-Scope heraus, Konstanten von aussen sind hier nicht sichtbar.
  const eigeneSeiten = new Set(["fitnessstudios-karlsruhe"]);
  return branchen
    .filter((b) => !eigeneSeiten.has(b.slug))
    .map((b) => ({ params: { branche: b.slug } }));
}

const { branche } = Astro.params;
const item = getBranche(branche!);
if (!item) return Astro.redirect("/404");

/**
 * Anti-Spam: In den wiederhergestellten Beitraegen stehen Anbieter-Adressen im
 * Klartext. Beim Rendern ersetzen wir das @ durch "(at)" und entfernen
 * mailto-Links, damit Harvester nichts abgreifen koennen. Die Quelldaten
 * bleiben unveraendert.
 */
const obfuscateEmails = (html: string) =>
  html
    .replace(/<a[^>]*href=["']mailto:([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi, (_m, _addr, label) => label)
    .replace(
      /([A-Za-z0-9._%+-]+)@([A-Za-z0-9.-]+\.[A-Za-z]{2,})/g,
      '$1<span aria-hidden="true">(at)</span><span class="sr-only">@</span>$2'
    );

let bodyHtml = obfuscateEmails(item.bodyHtml);

/**
 * Visual Semantics: Die Seiten beantworten eine Local-Service-Query
 * ("steuerberater karlsruhe"). Das Soll-Layout ist eine Anbieterliste, im
 * Bestand steht sie als Fliesstext mit H2 je Anbieter ("1. Andrea Kubek").
 *
 * Hier werden die H2 mit Ankern versehen und als Sprungliste ueber den Text
 * gesetzt. Es entsteht keine neue Aussage - nur eine navigierbare Struktur.
 */
const slugifyHeading = (text: string) =>
  text
    .toLowerCase()
    .replace(/&[a-z]+;/g, " ")
    .replace(/[äÄ]/g, "ae")
    .replace(/[öÖ]/g, "oe")
    .replace(/[üÜ]/g, "ue")
    .replace(/ß/g, "ss")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 60);

const briefHeadings: { depth: number; slug: string; text: string }[] = [];
const seenAnchors = new Set<string>();
bodyHtml = bodyHtml.replace(/<h2(\s[^>]*)?>([\s\S]*?)<\/h2>/gi, (match, attrs = "", inner) => {
  const text = String(inner).replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
  if (!text) return match;
  let anchor = slugifyHeading(text) || `abschnitt-${briefHeadings.length + 1}`;
  while (seenAnchors.has(anchor)) anchor = `${anchor}-2`;
  seenAnchors.add(anchor);
  briefHeadings.push({ depth: 2, slug: anchor, text });
  if (/\sid=/.test(String(attrs))) return match;
  return `<h2${attrs ?? ""} id="${anchor}">${inner}</h2>`;
});

// Bestenliste erkannt, wenn die erste Ueberschrift nummeriert ist.
const isRanking = briefHeadings.some((h) => /^\d+\.\s/.test(h.text));
const briefJumps = isRanking
  ? briefHeadings.filter((h) => /^\d+\.\s/.test(h.text))
  : briefHeadings;

// Vorschlaege fuer interne Verlinkung (andere Branchen, alphabetisch nahe)
const others = branchen.filter((b) => b.slug !== item.slug);
const related = others.slice(0, 12);

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: item.title,
  description: item.description,
  url: `${city.domain}/${item.slug}/`,
  isPartOf: { "@id": `${city.domain}/#website` },
  about: { "@type": "City", name: city.name },
};
---

<BaseLayout title={item.title} description={item.description}>
  <article class="container-page py-12">
    <Breadcrumbs items={[
      { label: "Start", href: "/" },
      { label: "Branchenbuch", href: "/branchenbuch/" },
      { label: item.label },
    ]} />

    <header class="mb-8 max-w-3xl">
      <p class="eyebrow mb-3">Branchenbuch &middot; {city.name}</p>
      <h1 class="text-[1.75rem] sm:text-5xl font-medium tracking-tight mb-3" style="color: var(--color-text);">{item.title}</h1>
      <p class="branche-lede" style="color: var(--color-text-body);">{item.description}</p>
      <EntityBrief
        headings={briefJumps}
        jumpLabel={isRanking ? "Anbieter auf dieser Seite" : "Direkt zu"}
        maxJumps={isRanking ? 10 : 5}
        excludeText={item.title}
      />
    </header>

    <div class="branchen-prose max-w-3xl" set:html={bodyHtml} />

    <p class="mt-10 text-xs max-w-3xl" style="color: var(--color-text-subtle);">
      Hinweis: Die Anbieterangaben (Adressen, Kontaktdaten, Leistungen) stammen aus
      unserer redaktionellen Recherche und werden ohne Gewähr bereitgestellt.
      Bitte prüfe Details direkt beim jeweiligen Anbieter.
    </p>

    <section class="mt-14 pt-10 border-t" style="border-color: var(--color-border);">
      <h2 class="text-sm font-bold uppercase tracking-widest mb-5" style="color: var(--color-text);">Weitere Branchen in Karlsruhe</h2>
      <div class="flex flex-wrap gap-2">
        {related.map((b) => (
          <a href={`/${b.slug}/`} class="pill">{b.label}</a>
        ))}
        <a href="/branchenbuch/" class="pill-accent">Alle Branchen &rarr;</a>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline></script>
  </article>
</BaseLayout>

<style>
  /* Die description ist ein Rohabzug des Textanfangs - auf Mobile gekuerzt,
     der volle Text steht direkt darunter. */
  .branche-lede {
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .branche-lede { font-size: 1.0625rem; line-height: 1.6; -webkit-line-clamp: 3; }
  }
  .branchen-prose :global(h2) {
    font-size: 1.6rem;
    line-height: 1.25;
    font-weight: 600;
    margin: 2.4rem 0 0.9rem;
    color: var(--color-text);
    scroll-margin-top: 5rem;
  }
  .branchen-prose :global(h3) {
    font-size: 1.18rem;
    font-weight: 600;
    margin: 1.7rem 0 0.6rem;
    color: var(--color-text);
  }
  .branchen-prose :global(h4) {
    font-size: 1rem;
    font-weight: 600;
    margin: 1.3rem 0 0.5rem;
    color: var(--color-text);
  }
  .branchen-prose :global(p) {
    margin: 0.9rem 0;
    line-height: 1.75;
    color: var(--color-text-body);
  }
  .branchen-prose :global(ul),
  .branchen-prose :global(ol) {
    margin: 0.9rem 0;
    padding-left: 1.4rem;
    color: var(--color-text-body);
    line-height: 1.7;
  }
  .branchen-prose :global(ul) { list-style: disc; }
  .branchen-prose :global(ol) { list-style: decimal; }
  .branchen-prose :global(li) { margin: 0.35rem 0; }
  .branchen-prose :global(strong) { color: var(--color-text); font-weight: 600; }
  .branchen-prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .branchen-prose :global(blockquote) {
    margin: 1.4rem 0;
    padding: 0.4rem 0 0.4rem 1.1rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-text);
    font-style: italic;
  }
</style>
