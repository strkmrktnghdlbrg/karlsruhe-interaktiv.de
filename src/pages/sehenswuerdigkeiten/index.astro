---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SightCard from "../../components/SightCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import GetYourGuideWidget from "../../components/GetYourGuideWidget.astro";
import { sights } from "../../data/sights";
import { getGygPlacement } from "../../data/gyg";
import { city } from "../../data/city";
import { indexUrl } from "../../i18n/config";
const sorted = [...sights].sort((a, b) => a.name.localeCompare(b.name, "de"));
---

<BaseLayout title={`Sehenswürdigkeiten in ${city.name}`} description={`Alle ${sights.length} Sehenswürdigkeiten in Karlsruhe: Schloss, ZKM, Pyramide, Turmberg und mehr.`} alternateUrls={{ de: indexUrl("sights", "de"), en: indexUrl("sights", "en") }}>
  <div class="container-page py-12">
    <Breadcrumbs items={[{label: "Start", href: "/"}, {label: "Sehenswürdigkeiten"}]} />
    <header class="mb-12">
      <p class="eyebrow mb-3">{sights.length} Einträge</p>
      <h1 class="text-4xl sm:text-6xl font-medium tracking-tight mb-4" style="color: var(--color-text);">Sehenswürdigkeiten in Karlsruhe</h1>
      <p class="text-lg max-w-3xl" style="color: var(--color-text-body);">
        Vom barocken Schloss bis zum weltweit einzigartigen ZKM, vom Turmberg in Durlach bis zum Bundesverfassungsgericht - alle ikonischen Orte der Faecherstadt.
      </p>
    </header>
    <div class="mosaic">
      {sorted.map((s, i) => (
        <div class={i % 7 === 0 ? "w2" : i % 7 === 3 ? "h2" : undefined}><SightCard sight={s} /></div>
      ))}
    </div>

    <GetYourGuideWidget placement={getGygPlacement("page:sights-index")} />
  </div>
</BaseLayout>
