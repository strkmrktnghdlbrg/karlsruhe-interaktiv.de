---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import StageHero from "../../../components/StageHero.astro";
import ActionDock from "../../../components/ActionDock.astro";
import SightCard from "../../../components/SightCard.astro";
import HotelCard from "../../../components/HotelCard.astro";
import RestaurantCard from "../../../components/RestaurantCard.astro";
import Stay22NearbyHotels from "../../../components/Stay22NearbyHotels.astro";
import GetYourGuideWidget from "../../../components/GetYourGuideWidget.astro";
import { districts } from "../../../data/districts";
import type { District } from "../../../data/districts";
import { sightsByDistrict } from "../../../data/sights";
import { topHotelsByDistrict } from "../../../data/hotels";
import { restaurantsByDistrict } from "../../../data/restaurants";
import { getGygPlacement } from "../../../data/gyg";
import { districtsEn, type DistrictEn } from "../../../i18n/en/districts";
import { detailUrl, homeUrl, indexUrl } from "../../../i18n/config";
import { t, tf } from "../../../i18n/ui";

export function getStaticPaths() {
  return districts.map((d) => ({
    params: { slug: districtsEn[d.slug].slug },
    props: { district: d, en: districtsEn[d.slug] },
  }));
}

interface Props {
  district: District;
  en: DistrictEn;
}

const { district, en } = Astro.props;
const locale = "en";

const name = en.name;
const sightItems = sightsByDistrict(district.slug);
const hotelItems = topHotelsByDistrict(district.slug, 8);
const restItems = restaurantsByDistrict(district.slug).slice(0, 8);
---

<BaseLayout
  title={name}
  description={en.shortDesc}
  locale={locale}
  alternateUrls={{
    de: `/bezirke/${district.slug}/`,
    en: detailUrl("districts", en.slug, "en"),
  }}
>
  <StageHero
    imgKey={district.imageKey ?? `district:${district.slug}`}
    badge={`${t(locale, "detail.district")} · ${en.characterTags.slice(0, 2).join(" · ")}`}
    title={name}
    lead={en.shortDesc}
    fallbackHue={district.hue}
    minHeight="500px"
  />

  <ActionDock
    info={{
      line: name,
      sub: `${sightItems.length} sights · ${hotelItems.length} hotels · ${restItems.length} restaurants`,
    }}
    secondary={{ label: "All districts", href: indexUrl("districts", locale) }}
    primary={{ label: "Hotels in the district", href: "#hotels-in-district" }}
  />

  <div class="container-page py-10">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t(locale, "nav.home"), href: homeUrl(locale) },
        { label: t(locale, "nav.districts"), href: indexUrl("districts", locale) },
        { label: name },
      ]}
    />

    <div class="stage-prose mt-6 mb-4">
      <p>{en.longDesc}</p>
    </div>
    <div class="flex flex-wrap gap-2 mb-6">
      {en.characterTags.map((tag) => <span class="pill">{tag}</span>)}
    </div>

    {sightItems.length > 0 && (
      <section class="section">
        <h2 class="text-3xl font-bold tracking-tight mb-6" style="color: var(--color-text);">{tf(locale, "detail.sightsIn", { name })}</h2>
        <div class="mosaic">
          {sightItems.map((s, i) => (
            <div class={i === 0 ? "w2" : undefined}><SightCard sight={s} locale={locale} /></div>
          ))}
        </div>
      </section>
    )}

    {hotelItems.length > 0 && (
      <section id="hotels-in-district" class="section border-t" style="border-color: var(--color-border);">
        <h2 class="text-3xl font-bold tracking-tight mb-6" style="color: var(--color-text);">{tf(locale, "detail.hotelsIn", { name })}</h2>
        <div class="mosaic">
          {hotelItems.map((h) => (
            <div><HotelCard hotel={h} locale={locale} /></div>
          ))}
        </div>
      </section>
    )}

    {restItems.length > 0 && (
      <section class="section border-t" style="border-color: var(--color-border);">
        <h2 class="text-3xl font-bold tracking-tight mb-6" style="color: var(--color-text);">{tf(locale, "detail.restaurantsIn", { name })}</h2>
        <div class="mosaic">
          {restItems.map((r) => (
            <div><RestaurantCard restaurant={r} locale={locale} /></div>
          ))}
        </div>
      </section>
    )}

    <GetYourGuideWidget placement={getGygPlacement(`district:${district.slug}`)} locale="en" />

    <Stay22NearbyHotels
      lat={district.coordinates[0]}
      lng={district.coordinates[1]}
      near={name}
      radius={2500}
      limit={4}
      locale={locale}
    />
  </div>
</BaseLayout>
