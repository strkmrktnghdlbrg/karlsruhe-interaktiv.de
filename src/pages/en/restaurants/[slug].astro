---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import StageHero from "../../../components/StageHero.astro";
import ActionDock from "../../../components/ActionDock.astro";
import RelatedItems from "../../../components/RelatedItems.astro";
import { restaurants } from "../../../data/restaurants";
import { restaurantsEn } from "../../../i18n/en/restaurants";
import { districtsEn } from "../../../i18n/en/districts";
import { getDistrict } from "../../../data/districts";
import { heroKey, getImage } from "../../../data/images";
import { city } from "../../../data/city";
import { detailUrl, homeUrl, indexUrl } from "../../../i18n/config";
import { t } from "../../../i18n/ui";

const locale = "en" as const;

export function getStaticPaths() {
  return restaurants.map((r) => ({
    params: { slug: restaurantsEn[r.slug].slug },
    props: { restaurant: r, en: restaurantsEn[r.slug] },
  }));
}

const { restaurant, en } = Astro.props;
const district = getDistrict(restaurant.district);
const districtEn = districtsEn[restaurant.district];
const districtName = districtEn?.name ?? district?.name ?? restaurant.district;

/* No photos of private businesses -> district photo as an honest stage */
const stageKey = heroKey(restaurant.imageKey ?? `restaurant:${restaurant.slug}`, restaurant.district);
const usesDistrictPhoto = stageKey?.startsWith("district:") && Boolean(getImage(stageKey));

const schema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: en.name,
  description: en.shortDesc,
  servesCuisine: en.cuisine,
  priceRange: restaurant.priceLevel,
  address: { "@type": "PostalAddress", addressLocality: city.name, addressCountry: city.countryCode },
  ...(en.openingHours && { openingHours: en.openingHours }),
  ...(restaurant.websiteUrl && { url: restaurant.websiteUrl }),
  ...(restaurant.reservation !== undefined && { acceptsReservations: restaurant.reservation }),
};
---

<BaseLayout
  title={en.name}
  description={en.shortDesc}
  locale={locale}
  alternateUrls={{
    de: detailUrl("restaurants", restaurant.slug, "de"),
    en: detailUrl("restaurants", en.slug, "en"),
  }}
>
  <article>
    <StageHero
      imgKey={stageKey}
      badge={`${en.cuisine} · ${restaurant.priceLevel}${district ? ` · ${districtName}` : ""}`}
      title={en.name}
      lead={en.shortDesc}
      sceneLabel={usesDistrictPhoto ? `Photo: ${districtName}` : undefined}
      fallbackHue={restaurant.imageHue}
      minHeight="500px"
    />

    <ActionDock
      info={{
        line: districtName,
        sub: [
          en.openingHours ? `Hours according to the operator: ${en.openingHours} · as of July 2026` : null,
          restaurant.reservation ? t(locale, "detail.reservationRecommended") : restaurant.reservation === false ? t(locale, "detail.walkIn") : null,
        ].filter(Boolean).join(" · ") || `${en.cuisine} · ${restaurant.priceLevel}`,
      }}
      secondary={districtEn ? { label: "District hub", href: detailUrl("districts", districtEn.slug, locale) } : undefined}
      primary={restaurant.websiteUrl
        ? { label: t(locale, "detail.website"), href: restaurant.websiteUrl, rel: "nofollow noopener", target: "_blank" }
        : { label: "All restaurants", href: indexUrl("restaurants", locale) }}
    />

    <div class="container-page py-10">
      <Breadcrumbs
        locale={locale}
        items={[
          { label: t(locale, "nav.home"), href: homeUrl(locale) },
          { label: t(locale, "nav.restaurants"), href: indexUrl("restaurants", locale) },
          { label: en.name },
        ]}
      />

      <div class="stage-prose mt-6 mb-6">
        <p>{en.longDesc}</p>
      </div>

      <div class="flex flex-wrap gap-2 mb-6">
        {en.openingHours && <span class="pill">{en.openingHours}</span>}
        {restaurant.reservation && <span class="pill">{t(locale, "detail.reservationRecommended")}</span>}
        {restaurant.reservation === false && <span class="pill">{t(locale, "detail.walkIn")}</span>}
      </div>

      <RelatedItems district={restaurant.district} excludeSlug={restaurant.slug} type="restaurants" locale={locale} />
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline></script>
  </article>
</BaseLayout>
