---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StageHero from "../../components/StageHero.astro";
import PhotoMosaic from "../../components/PhotoMosaic.astro";
import ContentImage from "../../components/ContentImage.astro";
import SightCard from "../../components/SightCard.astro";
import HotelCard from "../../components/HotelCard.astro";
import DistrictCard from "../../components/DistrictCard.astro";
import NewsCard from "../../components/NewsCard.astro";
import Stay22TopHotels from "../../components/Stay22TopHotels.astro";
import GetYourGuideWidget from "../../components/GetYourGuideWidget.astro";
import { city } from "../../data/city";
import { getGygPlacement } from "../../data/gyg";
import { sights, sightsByDistrict } from "../../data/sights";
import { topHotels } from "../../data/hotels";
import { districts } from "../../data/districts";
import { recentNews } from "../../data/news";
import { features } from "../../data/features";
import { sightsEn } from "../../i18n/en/sights";
import { districtsEn } from "../../i18n/en/districts";
import { t } from "../../i18n/ui";
import { indexUrl, detailUrl } from "../../i18n/config";

const featuredSights = sights.slice(0, 6);
const featuredHotels = topHotels(4);
const featuredDistricts = districts.slice(0, 6);
const featuredNews = features.news.enabled ? recentNews(3) : [];
const durlachSights = sightsByDistrict("durlach").length;

/* Five entry points, mixed tile sizes (mockup variant 3) */
const mosaikItems = [
  { href: detailUrl("districts", districtsEn["durlach"].slug, "en"), imgKey: "district:durlach", title: "Durlach", meta: `Older than the city · ${durlachSights} places`, span: "h2" as const },
  { href: detailUrl("categories", "museums", "en"), imgKey: "sight:staatliche-kunsthalle", title: "Art & museums", meta: "Kunsthalle, ZKM, Landesmuseum", span: "w2" as const },
  { href: detailUrl("categories", "parks-green-spaces", "en"), imgKey: "sight:schlossgarten", title: "Parks", meta: "Palace garden, Stadtgarten" },
  { href: detailUrl("sights", sightsEn["turmberg"].slug, "en"), imgKey: "sight:turmberg", title: "Views", meta: "Turmberg" },
  { href: detailUrl("sights", sightsEn["marktplatz-pyramide"].slug, "en"), imgKey: "sight:marktplatz-pyramide", title: "The fan", meta: "Market square, pyramid, Kaiserstrasse", span: "w2" as const },
];
---

<BaseLayout
  title={city.name}
  description={city.description.long}
  locale="en"
  alternateUrls={{ de: "/", en: "/en/" }}
>
  <!-- STAGE HERO -->
  <StageHero
    imgKey="sight:karlsruher-schloss"
    badge="The fan city"
    title="Karlsruhe starts at the palace."
    lead={`${city.stats.sights} attractions, ${city.stats.districts} districts, ${city.stats.restaurants} restaurants - with real photos, verified details and no ranking carousel.`}
  />

  <!-- WHERE TO START: mosaic -->
  <section class="stage-sec">
    <div class="container-page">
      <h2>Where to start</h2>
      <p class="stage-sub">Five entry points that cover most of the city.</p>
      <PhotoMosaic items={mosaikItems} />
    </div>
  </section>

  <!-- TOP SIGHTS -->
  <section class="stage-sec alt">
    <div class="container-page">
      <div class="flex items-end justify-between mb-2">
        <h2>{t("en", "home.sightsHeading")}</h2>
        <a href={indexUrl("sights", "en")} class="hidden sm:inline-flex link-accent text-sm">{t("en", "home.seeAll")}</a>
      </div>
      <div class="mosaic mt-6">
        {featuredSights.map((s, i) => (
          <div class={i === 0 ? "w2" : undefined}><SightCard sight={s} locale="en" /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- GETYOURGUIDE TOURS & TICKETS -->
  <section class="container-page">
    <GetYourGuideWidget placement={getGygPlacement("page:home")} locale="en" />
  </section>

  <!-- STORY -->
  <div class="story">
    <div class="story-pic">
      <ContentImage imgKey="sight:bundesverfassungsgericht" fallbackHue={1} showCredit imgClass="w-full h-full object-cover" />
    </div>
    <div class="story-txt">
      <span class="badge">In focus</span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mt-4 mb-3" style="color: var(--color-text);">Residence of the law</h2>
      <p class="stage-sub" style="margin-bottom: 20px;">
        Why Germany's highest court sits in Karlsruhe - and what there is to see.
      </p>
      <a href={detailUrl("sights", sightsEn["bundesverfassungsgericht"].slug, "en")} class="btn-outline">Read more &rarr;</a>
    </div>
  </div>

  <!-- DISTRICTS -->
  <section class="stage-sec">
    <div class="container-page">
      <div class="flex items-end justify-between mb-2">
        <h2>{t("en", "home.districtsHeading")}</h2>
        <a href={indexUrl("districts", "en")} class="hidden sm:inline-flex link-accent text-sm">{t("en", "home.allDistricts")}</a>
      </div>
      <div class="mosaic mt-6">
        {featuredDistricts.map((d, i) => (
          <div class={i === 1 ? "w2" : undefined}><DistrictCard district={d} locale="en" /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- TOP HOTELS (Live Stay22 + editorial) -->
  <section class="stage-sec alt">
    <div class="container-page">
      <div class="flex items-end justify-between mb-2">
        <h2>{t("en", "home.hotelsHeading")}</h2>
        <a href={indexUrl("hotels", "en")} class="hidden sm:inline-flex link-accent text-sm">{t("en", "home.allHotels")}</a>
      </div>
      <Stay22TopHotels limit={4} title="" lead={t("en", "home.hotelsLead")} locale="en" />
      <div class="mosaic mt-4">
        {featuredHotels.map((h) => (
          <div><HotelCard hotel={h} locale="en" /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- NEWS / Tech USP -->
  {features.news.enabled && featuredNews.length > 0 && (
    <section class="stage-sec">
      <div class="container-page">
        <div class="flex items-end justify-between mb-2">
          <h2>{t("en", "home.newsHeading")}</h2>
          <a href={indexUrl("news", "en")} class="hidden sm:inline-flex link-accent text-sm">{t("en", "home.allNews")}</a>
        </div>
        <div class="mosaic cols-3 mt-6">
          {featuredNews.map((n) => (
            <div><NewsCard item={n} locale="en" /></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FOR BUSINESSES -->
  <section class="stage-sec alt border-t" style="border-color: var(--color-border);">
    <div class="container-page">
      <h2>For businesses from Karlsruhe</h2>
      <p class="stage-sub">
        Basic listing free and permanent. Premium presence 199 € per year net, businesses only.
      </p>
      <a href="/en/advertise/" class="btn-primary">Advertising options &rarr;</a>
    </div>
  </section>
</BaseLayout>
