---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import StageHero from "../../../components/StageHero.astro";
import ActionDock from "../../../components/ActionDock.astro";
import OsmAttribution from "../../../components/OsmAttribution.astro";
import { city } from "../../../data/city";
import {
  branchenCategories,
  getBranchenCategory,
  listingsByCategory,
  branchenArticles,
} from "../../../data/branchenverzeichnis";
import "../../../styles/werben.css";

export function getStaticPaths() {
  return branchenCategories.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kategorie = getBranchenCategory(slug!)!;
const listings = listingsByCategory(kategorie.slug);

/*
 * Redaktionelle Eintraege (Premium + Portal) stehen oben und verlinken auf ihre
 * bestehende Detailseite. Die OSM-Listings darunter sind reine Eintraege ohne
 * Detailseite; sie werden nach Feinkategorie gebuendelt, damit die Liste
 * lesbar bleibt. ODbL: Attribution ist Pflicht, sobald OSM-Daten erscheinen.
 */
const redaktionell = listings.filter((l) => l.sourceType !== "osm");
const osmListings = listings.filter((l) => l.sourceType === "osm");
const hasOsm = osmListings.length > 0;

const collator = new Intl.Collator("de", { sensitivity: "base" });
const osmGruppen = Object.entries(
  osmListings.reduce<Record<string, typeof osmListings>>((acc, l) => {
    const key = l.subcategory || kategorie.name;
    (acc[key] ??= []).push(l);
    return acc;
  }, {}),
).sort((a, b) => b[1].length - a[1].length || collator.compare(a[0], b[0]));

/*
 * Leere Kategorien bleiben erreichbar und verlinkt (sie laden zum ersten
 * Eintrag ein), gehen aber nicht in den Index - sonst waeren es duenne Seiten.
 */
const noindex = listings.length === 0;
const artikel = branchenArticles(kategorie.slug);

const initials = (name: string) =>
  name
    .replace(/[^A-Za-zÄÖÜäöüß ]/g, "")
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase())
    .join("");

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${kategorie.name} in ${city.name}`,
  description: kategorie.description,
  url: `${city.domain}/branchenbuch/kategorie/${kategorie.slug}/`,
};
---

<BaseLayout
  noindex={noindex}
  title={`${kategorie.name} in ${city.name}`}
  description={`${kategorie.name} in ${city.name}: ${listings.length} Einträge aus dem Branchenbuch von ${city.name}-Interaktiv. Kostenloser Eintrag für Betriebe möglich.`}
>
  <StageHero
    badge={`${listings.length} ${listings.length === 1 ? "Eintrag" : "Einträge"}`}
    title={`${kategorie.name} in ${city.name}`}
    lead={kategorie.description}
    fallbackHue={1}
    compact
    minHeight="380px"
  />

  <ActionDock
    info={{
      line: "Grundeintrag: kostenlos",
      sub: "Premium-Auftritt: 199 € / Jahr netto (236,81 € brutto) · nur für Unternehmer · keine automatische Verlängerung",
    }}
    secondary={{ label: "Ganz oben stehen?", href: "/werben/premium-partner/" }}
    primary={{ label: "Kostenlos eintragen", href: "/branchenbuch/eintrag-beanspruchen/" }}
  />

  <div class="container-page py-12">
    <Breadcrumbs items={[
      { label: city.name, href: "/" },
      { label: "Branchenbuch", href: "/branchenbuch/" },
      { label: kategorie.name },
    ]} />

    {redaktionell.length > 0 && (
      <section class="mb-14 max-w-3xl">
        <h2 class="text-2xl font-semibold tracking-tight mb-4" style="color: var(--color-text);">
          Betriebe
        </h2>
        <div>
          {redaktionell.map((l) => (
            l.premium ? (
              <div class="werben-mock is-premium" style="margin-bottom:0.9rem;">
                <div class="flex items-center justify-between mb-3">
                  <p class="eyebrow">Premium-Partner</p>
                  <span class="badge">&#9733; Premium</span>
                </div>
                <div class="werben-mock-head">
                  <span class="werben-avatar is-premium">{initials(l.name)}</span>
                  <div>
                    <p class="branchen-item-name">{l.name}</p>
                    <p class="branchen-item-meta">
                      {[l.address, l.districtLabel].filter(Boolean).join(" · ")}
                    </p>
                  </div>
                </div>
                {l.description && (
                  <p class="text-sm mt-3" style="color: var(--color-text-body);">{l.description}</p>
                )}
                <div class="werben-mock-actions">
                  {l.website && (
                    <a class="werben-mock-btn" href={l.website} target="_blank" rel="noopener">Website</a>
                  )}
                  {l.phone && <span class="werben-mock-btn">{l.phone}</span>}
                  {l.email && (
                    <span class="werben-mock-btn">
                      {l.email.split("@")[0]}<span aria-hidden="true">(at)</span><span class="sr-only">@</span>{l.email.split("@")[1]}
                    </span>
                  )}
                </div>
              </div>
            ) : (
              <div class="branchen-item">
                <span class="branchen-item-name">
                  {l.href ? <a href={l.href} class="link-accent">{l.name}</a> : l.name}
                </span>
                <span class="branchen-item-meta">
                  {[l.address, l.districtLabel].filter(Boolean).join(" · ")}
                </span>
              </div>
            )
          ))}
        </div>
        <p class="werben-muted-note">
          Alle Angaben ohne Gewähr. Adressen stammen aus den verlinkten Beiträgen dieses Portals und aus
          öffentlich zugänglichen Quellen. Fehler bitte an die
          <a href="/kontakt/" class="link-accent">Redaktion</a> melden.
        </p>
      </section>
    )}

    {hasOsm && (
      <section class="mb-14 max-w-3xl">
        <h2 class="text-2xl font-semibold tracking-tight mb-2" style="color: var(--color-text);">
          Weitere Betriebe in {city.name}
        </h2>
        <p class="mb-6" style="color: var(--color-text-body);">
          {osmListings.length} weitere Adressen aus der offenen Kartendatenbank OpenStreetMap. Diese
          Einträge sind unbestätigt und haben keine eigene Seite. Betriebe können ihren Eintrag
          kostenlos <a href="/branchenbuch/eintrag-beanspruchen/" class="link-accent">beanspruchen</a>
          und korrigieren lassen.
        </p>
        {osmGruppen.map(([gruppe, eintraege]) => (
          <div class="mb-8">
            <h3 class="text-lg font-semibold mb-3" style="color: var(--color-text);">
              {gruppe} <span style="color: var(--color-text-subtle); font-weight: 400;">({eintraege.length})</span>
            </h3>
            <div>
              {eintraege.map((l) => (
                <div class="branchen-item">
                  <span class="branchen-item-name">{l.name}</span>
                  <span class="branchen-item-meta">
                    {[l.address, l.districtLabel].filter(Boolean).join(" · ")}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}
        <p class="werben-muted-note">
          Alle Angaben ohne Gewähr. Stand der Kartendaten kann abweichen. Fehler bitte an die
          <a href="/kontakt/" class="link-accent">Redaktion</a> melden.
        </p>
        <OsmAttribution />
      </section>
    )}

    {listings.length === 0 && (
      <section class="werben-card mb-14 max-w-3xl">
        <h2 class="text-xl font-semibold mb-2" style="color: var(--color-text);">
          Noch kein Eintrag in dieser Branche
        </h2>
        <p class="mb-4">
          In {kategorie.name} ist bisher kein Betrieb gelistet. Wer sich jetzt einträgt, steht als Erster
          in dieser Kategorie - der Grundeintrag ist kostenlos.
        </p>
        <a href="/branchenbuch/eintrag-beanspruchen/" class="btn-primary">Als Erster eintragen &rarr;</a>
      </section>
    )}

    {artikel.length > 0 && (
      <section class="mb-14 max-w-3xl">
        <h2 class="text-2xl font-semibold tracking-tight mb-4" style="color: var(--color-text);">
          Passende Beiträge im Branchenbuch
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {artikel.map((b) => (
            <a href={`/${b.slug}/`} class="card p-4" style="text-decoration:none;">
              <span class="font-medium" style="color: var(--color-text);">{b.label}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="werben-cta-band">
      <h2 class="text-2xl font-semibold tracking-tight mb-3" style="color: var(--color-text);">
        Ihr Betrieb fehlt hier noch?
      </h2>
      <p class="mb-6 max-w-xl mx-auto" style="color: var(--color-text-body);">
        Der Grundeintrag ist kostenlos und dauerhaft. Zwei Minuten Aufwand.
      </p>
      <a href="/branchenbuch/eintrag-beanspruchen/" class="btn-primary">Jetzt kostenlos eintragen &rarr;</a>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline></script>
  </div>
</BaseLayout>
