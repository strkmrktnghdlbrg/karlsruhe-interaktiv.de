---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import StageHero from "../../components/StageHero.astro";
import ActionDock from "../../components/ActionDock.astro";
import OsmAttribution from "../../components/OsmAttribution.astro";
import { branchen } from "../../data/branchen";
import { city } from "../../data/city";
import {
  branchenCategories,
  categoryCount,
  totalListings,
  osmListingCount,
} from "../../data/branchenverzeichnis";
import "../../styles/werben.css";

const sorted = [...branchen].sort((a, b) => a.label.localeCompare(b.label, "de"));

const kategorien = branchenCategories.map((c) => ({ ...c, count: categoryCount(c.slug) }));
const gesamt = totalListings();

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Branchenbuch ${city.name}`,
  description: `Anbieter und Dienstleister in ${city.name}: ${branchen.length} Branchen mit Adressen und Profilen.`,
  url: `${city.domain}/branchenbuch/`,
};
---

<BaseLayout
  title={`Branchenbuch ${city.name}`}
  description={`Das Karlsruher Branchenbuch: ${branchen.length} Branchen von Notaren über Handwerker bis IT-Dienstleister - mit Anbieterprofilen, Adressen und Kontaktwegen.`}
>
  <StageHero
    imgKey="sight:marktplatz-pyramide"
    badge={`${branchen.length} Branchen`}
    title="Branchenbuch Karlsruhe"
    lead="Vom Notar über den Handwerker bis zur Marketingagentur: Hier findest du empfehlenswerte Anbieter und Dienstleister aus Karlsruhe und Umgebung - redaktionell zusammengestellt, mit Adressen, Leistungen und Kontaktwegen."
    compact
  />

  <ActionDock
    info={{
      line: "Grundeintrag: kostenlos",
      sub: "Premium-Auftritt: 199 € / Jahr netto (236,81 € brutto) · nur für Unternehmer · keine automatische Verlängerung",
    }}
    secondary={{ label: "Premium-Partner werden", href: "/werben/premium-partner/" }}
    primary={{ label: "Kostenlos eintragen", href: "/branchenbuch/eintrag-beanspruchen/" }}
  />

  <div class="container-page py-12">
    <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Branchenbuch" }]} />

    <!-- Verzeichnis nach Kategorien -->
    <section class="mb-14">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight" style="color: var(--color-text);">
          Betriebe nach Kategorien
        </h2>
        <p class="text-sm" style="color: var(--color-text-muted);">{gesamt} Einträge</p>
      </div>
      <div class="werben-grid werben-grid-3">
        {kategorien.map((k) => (
          <a href={`/branchenbuch/kategorie/${k.slug}/`} class="werben-card" style="text-decoration:none;">
            <div class="flex items-baseline justify-between gap-3 mb-1">
              <h3 class="text-lg font-semibold" style="color: var(--color-text);">{k.name}</h3>
              <span class="pill">{k.count}</span>
            </div>
            <p>{k.description}</p>
            <div class="werben-card-cta">
              <span class="link-accent text-sm">
                {k.count > 0 ? "Betriebe ansehen" : "Als Erster eintragen"} &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
      <p class="werben-muted-note">
        Die kostenlosen Einträge stammen aus der redaktionellen Arbeit dieses Portals - Restaurants,
        Hotels, Apotheken und Banken, die hier bereits vorkommen - sowie aus {osmListingCount} Adressen
        der offenen Kartendatenbank OpenStreetMap. Diese Karteneinträge sind unbestätigt und lassen
        sich kostenlos <a href="/branchenbuch/eintrag-beanspruchen/" class="link-accent">beanspruchen</a>.
        Alle Angaben ohne Gewähr.
      </p>
      <p class="werben-muted-note">
        Sie möchten Ihren Betrieb nicht im Verzeichnis sehen? Melden Sie sich über das
        <a href="/kontakt/" class="link-accent">Kontaktformular</a>, wir nehmen den Eintrag in
        unsere Sperrliste auf. Er wird dann entfernt und erscheint auch bei künftigen
        Datenaktualisierungen aus OpenStreetMap nicht wieder.
      </p>
      <OsmAttribution />
    </section>

    <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-6" style="color: var(--color-text);">
      Branchen von A bis Z
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {sorted.map((b) => (
        <a href={`/${b.slug}/`} class="card p-5 flex items-center justify-between gap-3 group">
          <span class="font-medium" style="color: var(--color-text);">{b.label}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--color-text-muted);">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      ))}
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline></script>
  </div>
</BaseLayout>
