---
/**
 * Pflicht-Attribution fuer OpenStreetMap-Daten (ODbL).
 * Muss auf jeder Seite stehen, die OSM-Betriebsdaten anzeigt.
 */
interface Props {
  lang?: "de" | "en";
}
const { lang = "de" } = Astro.props;
---
<p class="osm-attr">
  {lang === "en" ? (
    <>Business data partly from <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap</a> contributors (ODbL), without guarantee.</>
  ) : (
    <>Betriebsdaten teils von <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap</a>-Mitwirkenden (ODbL), Angaben ohne Gewähr.</>
  )}
</p>

<style>
  .osm-attr {
    font-size: 0.75rem;
    line-height: 1.5;
    margin-top: 0.75rem;
    color: var(--color-text-subtle);
  }
  .osm-attr a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
