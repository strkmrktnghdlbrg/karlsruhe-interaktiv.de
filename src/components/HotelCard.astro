---
import ContentImage from "./ContentImage.astro";
import type { Hotel } from "../data/hotels";
import { getDistrict } from "../data/districts";
import { heroKey, getImage } from "../data/images";
import type { Locale } from "../i18n/config";
import { detailUrl } from "../i18n/config";
import { hotelsEn } from "../i18n/en/hotels";
import { districtsEn } from "../i18n/en/districts";

interface Props { hotel: Hotel; locale?: Locale }
const { hotel, locale = "de" } = Astro.props;
const district = getDistrict(hotel.district);
const starsLabel = "*".repeat(hotel.stars);

const en = locale === "en" ? hotelsEn[hotel.slug] : undefined;
const href = locale === "en" ? detailUrl("hotels", en!.slug, "en") : `/hotels/${hotel.slug}/`;
const name = en?.name ?? hotel.name;
const districtName = locale === "en" ? (districtsEn[hotel.district]?.name ?? district?.name ?? hotel.district) : (district?.name ?? hotel.district);

const favoriteLabel = locale === "en" ? "Guest favorite" : "Gästeliebling";
const fromLabel = locale === "en" ? "from" : "ab";
const perNightLabel = locale === "en" ? "/ night" : "/ Nacht";
const reviewsLabel = locale === "en" ? "reviews" : "Bew.";

/* Kein eigenes Hotelfoto vorhanden -> Bezirksfoto als ehrliche Buehne */
const imgKey = heroKey(`hotel:${hotel.slug}`, hotel.district);
const usesDistrictPhoto = imgKey?.startsWith("district:") && Boolean(getImage(imgKey));
---

<a href={href} class="tilecard group block">
  <div class="tilecard-media">
    <div class="tilecard-pic">
      <ContentImage
        imgKey={imgKey}
        fallbackHue={hotel.imageHue}
        fallbackLabel={name}
        imgClass="w-full h-full object-cover"
      />
    </div>
    <div class="veil"></div>
    <div class="tilecard-tags">
      <span class="pill" style="background: rgba(8,9,10,0.85); backdrop-filter: blur(8px);">{starsLabel}</span>
    </div>
    <div class="cap">
      <h3>{name}</h3>
      <span class="cap-meta">{usesDistrictPhoto ? `${districtName} · Foto: ${districtName}` : districtName}</span>
    </div>
  </div>
  <div class="tilecard-meta">
    <span><strong>{fromLabel} {hotel.priceFrom} EUR</strong> {perNightLabel}</span>
  </div>
</a>
