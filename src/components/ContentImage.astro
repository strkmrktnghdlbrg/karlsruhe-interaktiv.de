---
import { Image } from "astro:assets";
import HueGradient from "./HueGradient.astro";
import { getImage } from "../data/images";

interface Props {
  imgKey?: string;
  fallbackHue?: number;
  fallbackLabel?: string;
  className?: string;
  imgClass?: string;
  loading?: "lazy" | "eager";
  aspect?: string;
  sizes?: string;
  widths?: number[];
}

const {
  imgKey,
  fallbackHue = 1,
  fallbackLabel,
  className = "",
  imgClass = "w-full h-full object-cover",
  loading = "lazy",
  aspect,
  sizes = "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw",
  widths = [400, 800, 1200, 1600],
} = Astro.props;

const entry = imgKey ? getImage(imgKey) : undefined;
const wrapperClass = aspect ? `${aspect} ${className}` : className;
---

{entry ? (
  <figure class={`relative ${wrapperClass}`}>
    <Image
      src={entry.src}
      alt={entry.alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      decoding="async"
      format="webp"
      quality={78}
      class={imgClass}
    />
    {/* Urheber + Lizenz stehen zentral unter /bildnachweis/ */}
  </figure>
) : (
  <div class={`relative ${wrapperClass}`}>
    <HueGradient hue={fallbackHue} label={fallbackLabel} />
  </div>
)}
