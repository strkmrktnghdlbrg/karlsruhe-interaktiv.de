# Keine generische /thema/*-Regel: darunter liegen echte Seiten.

# --- Backlink-Rescue: schirmer-graf.de ---------------------------------------
# Die Quelldomain (frueher ein Buchverlag) leitet auf /category/graf/ und haengt
# dabei den Originalpfad an, jeder Deep-Link landet also auf einer eigenen
# Nonsense-URL. Splat faengt alle davon auf der thematisch naechsten Seite ab.
/category/graf/*  /thema/buchhandlungen-karlsruhe/  301
/category/graf  /thema/buchhandlungen-karlsruhe/  301

